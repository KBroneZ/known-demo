{
  "name": "known-demo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "build": "node tools/build-all.mjs",
    "test": "node --test \"tools/tests/*.test.mjs\"",
    "check": "node tools/check-all.mjs",
    "golden:snapshot": "node tools/golden.mjs snapshot",
    "golden:diff": "node tools/golden.mjs diff",
    "prove:scale": "node tools/prove-scale.mjs",
    "new-client": "node tools/add-client.mjs",
    "format": "prettier --write \"tools/**/*.mjs\" \"packages/**/*.{ts,mjs,json}\" \"sites/**/*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"tools/**/*.mjs\" \"packages/**/*.{ts,mjs,json}\" \"sites/**/*.{ts,mjs,json}\""
  },
  "dependencies": {
    "astro": "7.4.4",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "node-html-parser": "^9.0.5",
    "prettier": "3.6.2",
    "puppeteer-core": "25.16.0"
  }
}
