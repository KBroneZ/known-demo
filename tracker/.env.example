# Copy to .env (git-ignored) and fill in. Never commit real keys. An engine without its key is skipped.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# Google AI Overviews + AI Mode, via DataForSEO (third-party SERP provider)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Gemini grounding is intentionally not supported (its terms forbid storing/analysing results).
